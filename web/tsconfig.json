{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "types/**/*.d.ts",
    "shared/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "*.ts"
  ],
  "exclude": [
    "core",
    "dist",
    "node_modules",
    "app/vendor",
    "shared/vendor/*.js",
    "oauth-relay",
    "tests",
    "glyph-usage.ts",
    "shared/carry-texmf.ts",
    "vite.config.ts"
  ]
}
