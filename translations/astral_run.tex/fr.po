#. type: multicols*
#: clash/astral_run.tex:106
#, no-wrap
msgid ""
"\\begin{itemize}\n"
"  \\item \\textbf{Grail Token:} When gained, Search~(4) \\svg{artifact}. Your \\svg{hand} Limit is increased by 3.\n"
"  \\item \\textbf{Level VII Settlement:} Reinforce one \\svg{silver} Unit for free and increase two incomes by 1 space.\n"
"  \\item \\textbf{Random Town:} Gain 10~\\svg{gold}. You may recruit and reinforce one Faction Unit you defeated for half the \\svg{gold} cost.\n"
"  \\item \\textbf{Dragon Utopia:} Take any Card from your Discard Pile. You may recruit one dragon you defeated for half its recruitment cost or gain 10~\\svg{gold}.\n"
"  \\item \\textbf{11-Round game:} Remove $P$~×~Near \\mbox{(IV--V)} Map Tiles and replace the Center \\mbox{(VI--VII)} Tile with a Near \\mbox{(IV--V)} Map Tile without an Obelisk.\n"
"\\end{itemize}\n"
"\n"
msgstr ""
"\\begin{itemize}\n"
"  \\item \\textbf{Jeton Graal :} Lorsqu'il est gagné, Fouillez~(4) \\svg{artifact}. Votre limite de \\svg{hand} augmente de 3.\n"
"  \\item \\textbf{Enclave de Rang VII :} Améliorez gratuitement une Unité \\svg{silver} et avancez deux revenus de 1 case.\n"
"  \\item \\textbf{Ville Aléatoire :} Gagnez 10~\\svg{gold}. Vous pouvez recruter et améliorer une Unité de Faction que vous avez vaincue pour la moitié de son coût en \\svg{gold}.\n"
"  \\item \\textbf{Terres Désolées :} Prenez n'importe quelle Carte de votre Défausse. Vous pouvez recruter un dragon que vous avez vaincu pour la moitié de son coût de recrutement ou gagner 10~\\svg{gold}.\n"
"  \\item \\textbf{Partie en 11 Manches :} Retirez $P$~×~Tuiles Proches \\mbox{(IV--V)} et remplacez la Tuile Centre \\mbox{(VI--VII)} par une Tuile Proche \\mbox{(IV--V)} sans Obélisque.\n"
"\\end{itemize}\n"
"\n"

